# Copy this file to .env and replace each value. .env is ignored by Git.
# PostgreSQL superuser (the "DBA" account)
POSTGRES_PASSWORD=change-me
# Owner of the database utility_lab (the "schema owner")
LAB_OWNER_PASSWORD=change-me
# What the application code connects as
LAB_APP_PASSWORD=change-me
# MongoDB administrator, mongo_admin
MONGO_ROOT_PASSWORD=change-me
# MongoDB account the application code connects as, lab_app
MONGO_APP_PASSWORD=change-me
# MongoDB Atlas (Stage 5): the free cluster's host name, e.g. cluster0.ab1cd.mongodb.net
ATLAS_HOST=change-me
# MongoDB Atlas: the password of the Atlas database user lab_app
ATLAS_APP_PASSWORD=change-me